# /etc/makoto/backend.env — production configuration for the Makoto backend on Oracle.
# setup.sh copies this file once; then fill every CHANGE_ME value (copy them from
# Railway → makoto-backend → Variables → Raw Editor). Never commit real values.
# The service will not start while any CHANGE_ME remains.

NODE_ENV=production
BACKEND_PORT=3001

# Public site origin used for wallet verification (SIWE) and cookies.
PUBLIC_APP_ORIGIN=https://makotowallet.xyz
# Vercel → Caddy → app.
TASK_TRUST_PROXY_HOPS=2

# Persistent SQLite data (owned by the makoto user, backed up daily).
TASK_AUTH_DB_PATH=/var/lib/makoto/task-auth.sqlite
TASK_DB_PATH=/var/lib/makoto/tasks.sqlite
PORTFOLIO_HISTORY_DB_PATH=/var/lib/makoto/portfolio-history.sqlite

# Must be the SAME value as on Railway so existing wallet sessions stay valid.
TASK_SESSION_SECRET=CHANGE_ME

# Surf data API (market data, news, sentiment).
SURF_API_KEY=CHANGE_ME

# CoinGecko pricing.
COINGECKO_API_KEY=CHANGE_ME
COINGECKO_API_MODE=demo

# Makoto Agent (OpenAI Responses-compatible provider).
LLM_API_KEY=CHANGE_ME
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-luna
LLM_TIMEOUT_MS=30000
# Optional: Agent chat requests per client per minute (default 30).
# AGENT_RATE_LIMIT_PER_MIN=30
