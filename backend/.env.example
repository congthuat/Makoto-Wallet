BACKEND_PORT=3001
SURF_API_KEY=

# Server-only CoinGecko pricing. Use `demo` with api.coingecko.com or `pro` with pro-api.coingecko.com.
COINGECKO_API_KEY=
COINGECKO_API_MODE=demo

# Optional server-only conversational provider. Never use VITE_ here.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_MS=12000

# Task SIWE authentication. Local development defaults to http://localhost:5173.
# Public hosting requires an HTTPS origin and a random secret with at least 32 bytes.
PUBLIC_APP_ORIGIN=http://localhost:5173
TASK_SESSION_SECRET=
# Persistent same-host SQLite file for nonce, session, and rate-limit state.
TASK_AUTH_DB_PATH=
# Set only to the exact trusted reverse-proxy hop count when deployed behind one.
TASK_TRUST_PROXY_HOPS=
