NEXT_PUBLIC_PENGUJAR_ADDRESS=0x2d2C30ACe5d1f057C6eC2e2E8219A43355Dd226a
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id
# Circle Gateway Unified Balance is permissionless and needs no Circle API key.
# Server-side only. Never expose this as NEXT_PUBLIC_* or import it into client components.
KIT_KEY=

# Server-side only: required for the optional Phase 11B semantic classification API.
OPENAI_API_KEY=
# Optional server-side model override (default: gpt-5.6-luna).
PLANNER_CLASSIFIER_MODEL=
# Optional server-side Phase 11C plan model override (default: gpt-5.6-luna).
PLANNER_PLAN_MODEL=
# Optional server-side Phase 11D parameter model override (default: gpt-5.6-luna).
PLANNER_PARAMETER_MODEL=
# Disabled by default. Set true only for local/controlled HTTP classifier access.
# Production exposure requires an approved abuse-control boundary.
PLANNER_CLASSIFIER_HTTP_ENABLED=false

# Set only after verifying the official Arc Testnet Multicall3From address and ABI.
NEXT_PUBLIC_ARC_MULTICALL3_FROM=
