{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --prefix frontend",
  "buildCommand": "BACKEND_PORT=3001 BASE_PATH='' npm run build --prefix frontend",
  "outputDirectory": "frontend/dist/client",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.makotowallet.xyz/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
